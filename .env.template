# Copy to .env and fill in only what you need. NEVER commit .env.
# Existing shell environment variables win over .env values.
# The benchmark runs offline with no keys at all (dummy model, tests, reports).

# --- Model under test (OpenAI-compatible /v1/chat/completions endpoint) ---
# Base URL of any OpenAI-compatible server. Examples:
#   http://localhost:8000/v1   (self-hosted open-weight model, e.g. a local Apertus serving via vLLM)
#   https://api.openai.com/v1  (OpenAI)
#   https://openrouter.ai/api/v1  (OpenRouter)
OPENAI_BASE_URL=http://localhost:8000/v1

# Model identifier exactly as the endpoint expects it (e.g. "apertus-8b-instruct",
# "gpt-4.1-mini", "swiss-ai/Apertus-8B-Instruct-2509" — whatever your server serves).
OPENAI_MODEL=

# API key for the endpoint above. Leave empty for unauthenticated local servers.
# The variable name is passed via --api-key-env if you ever need a different one.
OPENAI_API_KEY=

# Optional: uncomment to point the harness at a different key variable name
# OPENAI_API_KEY_ENV=MY_PROVIDER_KEY
